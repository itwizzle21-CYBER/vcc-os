{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "deny",
    "write": "deny",
    "apply_patch": "deny",
    "bash": {
      "*": "deny",
      "ls *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git ls-files*": "allow"
    },
    "external_directory": {
      "*": "deny"
    },
    "task": {
      "*": "deny"
    },
    "todowrite": "allow",
    "todoread": "allow",
    "plan": "allow",
    "question": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
